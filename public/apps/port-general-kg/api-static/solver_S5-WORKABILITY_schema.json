{"id":"S5-WORKABILITY","name":"件杂货气象可作业性判定","chainType":"compliance","description":"按《港口件杂货装卸作业操作规程》5.1 判定风速/天气/货种/起重机型下能否作业。","inputs":[{"key":"wind_m_s","label":"风速","type":"slider","required":false,"default":12,"unit":"m/s","min":0,"max":30,"step":0.5,"note":"普通>20 / 重大件门机>15 / 浮吊重大件>12 停止"},{"key":"heavyGoods","label":"货种","type":"enum","required":false,"default":false,"options":[{"value":false,"label":"普通件杂货"},{"value":true,"label":"重大件"}]},{"key":"crane","label":"起重机型","type":"enum","required":false,"default":"gantry","options":[{"value":"gantry","label":"门座起重机（门机）"},{"value":"floating","label":"浮式起重机（浮吊）"}]},{"key":"weather","label":"天气","type":"enum","required":false,"default":"","options":[{"value":"","label":"（晴朗/无极端天气）"},{"value":"severeFog","label":"大雾橙色预警"},{"value":"orangerain","label":"暴雨（橙色预警）"},{"value":"thunder","label":"雷电"},{"value":"rain","label":"雨"},{"value":"snow","label":"雪"}]},{"key":"moistureMark","label":"货物防潮标志","type":"enum","required":false,"default":false,"options":[{"value":false,"label":"无（普通货物）"},{"value":true,"label":"标防潮标志"}]}],"missingDataNote":"实时风速需接 VTS/气象接口，一期未接显示「—」，禁止历史均值兜底"}